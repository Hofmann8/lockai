# API Keys (支持多组用于并发负载均衡，目前用于 gpt-image-2 等图片/搜索路径)
API_KEY_1=your_api_key_here
# API_KEY_2=
# API_KEY_3=

# Anthropic (Campbell — Claude Sonnet 4.6 via anthropic-native)
ANTHROPIC_API_KEY=

# Gemini (Campbell 1.5 Image — 实时绘图)
GEMINI_API_BASE_URL=https://api.vectorengine.ai
GEMINI_API_KEY=

# API Configuration
API_BASE_URL=https://api.vectorengine.ai
MODELS_CONFIG=models.json

# Qwen (用于内部搜索 / 标题生成；ASR 也复用本 key)
QWEN_API_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_API_KEY=your_dashscope_api_key

# DeepSeek (Scooby / Leo 主聊天模型)
DEEPSEEK_API_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=your_deepseek_api_key
MODEL_ASR_REALTIME=fun-asr-realtime-2026-02-28   # 语音识别模型，默认沿用 QWEN_API_KEY
ASR_BASE_WS_URL=wss://dashscope.aliyuncs.com/api-ws/v1/inference
ASR_LANGUAGE_HINTS=zh,en

# S3 Compatible Storage (用于存储生成的图片)
S3_ENDPOINT=https://s3.bitiful.net
S3_ACCESS_KEY=your_access_key
S3_SECRET_KEY=your_secret_key
S3_BUCKET=funkandlove-main
S3_PUBLIC_URL=https://funkandlove-main.s3.bitiful.net

# Flask Configuration
PORT=5003
FLASK_DEBUG=false
DATABASE_URL=sqlite:///lockai.db

# Dedicated Image / Legacy Paper Key
API_KEY_PAPER=                       # 现用于图片生成专属 key；留空则回退到 API_KEY_1/2/3 轮询池
MODEL_PAPER_RESEARCHER=              # 研究员（文献检索）
MODEL_PAPER_PLANNER=                 # 规划师（结构规划，建议用强模型）
MODEL_PAPER_WRITER=                  # 写手（内容撰写）
MODEL_PAPER_FORMATTER=               # 排版师（LaTeX 转换）
MODEL_GATE=                         # Paper 质量 Gate 模型
LATEX_COMPILER=local                 # local | remote
LATEX_FC_ENDPOINT=                   # FC 编译端点（生产用）
LATEX_FC_API_KEY=                    # FC API Key（生产用）
