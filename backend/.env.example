# RelayRouter (Campbell 主模型 + 绘图 / 修图 + 联网搜索 gpt-4.1-mini web_search)
API_BASE_URL=https://api.relayrouter.ai
RELAY_API_KEY=your_relayrouter_token

# 阿里云 CleverSee（原 IQS）联网搜索，控制台 aisearch.aliyun.com 创建
CLEVERSEE_API_KEY=your_cleversee_api_key

# DashScope (只用于语音识别)
QWEN_API_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_API_KEY=your_dashscope_api_key
MODEL_ASR_REALTIME=fun-asr-realtime-2026-02-28
ASR_BASE_WS_URL=wss://dashscope.aliyuncs.com/api-ws/v1/inference
ASR_LANGUAGE_HINTS=zh,en

# DeepSeek (Scooby 主聊天模型、标题 / 追问建议、给不能看图的模型转述图片)
DEEPSEEK_API_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=your_deepseek_api_key

# 阿里云 OSS（S3 兼容接口，存生成 / 上传的图片），RAM 用户 lock-service，权限限定在 lock-* 桶
# 服务器和桶同在北京时 ENDPOINT 用内网 https://oss-cn-beijing-internal.aliyuncs.com，免流量费
S3_ENDPOINT=https://oss-cn-beijing.aliyuncs.com
S3_REGION=cn-beijing
S3_ACCESS_KEY=your_access_key_id
S3_SECRET_KEY=your_access_key_secret
S3_BUCKET=lock-ai
S3_PUBLIC_URL=https://lock-ai.oss-cn-beijing.aliyuncs.com

# 阿里云函数计算云沙箱（E2B 协议兼容），API Key 在函数计算控制台创建，按地域生效
E2B_API_KEY=your_e2b_api_key
E2B_API_URL=https://api.cn-hangzhou.e2b.fc.aliyuncs.com
E2B_DOMAIN=cn-hangzhou.e2b.fc.aliyuncs.com
# 沙箱模板名（sandbox/build_template.py 登记时给出，带版本号）
SANDBOX_TEMPLATE=lockai-office-20260925e

# Server Configuration
# 端口规范：开发用整数端口，生产末位补 3（前端 3000/3003，后端 5000/5003）
PORT=5000
# python app.py 时是否热重载（旧变量名 FLASK_DEBUG 仍然认）
DEV_RELOAD=false
DATABASE_URL=sqlite:///lockai.db
MODELS_CONFIG=models.json

# Campbell 配额（可选）
CAMPBELL_DAILY_LIMIT=100      # 日额 credits
CAMPBELL_MONTHLY_LIMIT=1000   # 月额 credits
CREDIT_TOKEN_SCALE=5000       # 1 credit 等于多少计费量，普通一问一答约 1 credit
IMAGE_MIN_CREDITS=2           # 出图下限，一张图占住 worker 数十秒，不按 token 收得太低
